{
  "manifest_version": 3,
  "name": "GBF Battle Side Panel",
  "version": "1.13.126",
  "description": "GBFの戦闘情報、参戦者順位、最適ルート、導本効果候補を表示します。",
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "*://*.granbluefantasy.jp/*",
    "*://gbf.game.mbga.jp/*",
    "https://raw.githubusercontent.com/s1675dis/gbfExtensions/*"
  ],
  "background": { "service_worker": "service-worker-v2.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.granbluefantasy.jp/*",
        "*://gbf.game.mbga.jp/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": [
        "*://*.granbluefantasy.jp/*",
        "*://gbf.game.mbga.jp/*"
      ]
    }
  ],
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "戦闘情報を表示" }
}
